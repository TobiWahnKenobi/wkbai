# Writes buildinfo.h (BuildIdentity.cpp): the source commit and whether the source has uncommitted
# changes. Run at every build (the wkbai_buildinfo target); the file is rewritten only when it
# changes, so nothing is recompiled otherwise. -DSRC=<source folder> -DOUT=<header>
execute_process(COMMAND git -C "${SRC}" rev-parse --short=12 HEAD OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE r1)
if(NOT r1 EQUAL 0 OR commit STREQUAL "")
  set(commit "unknown")
endif()
# uncommitted changes to tracked files (untracked ones, build logs, don't make a build modified)
execute_process(COMMAND git -C "${SRC}" status --porcelain --untracked-files=no OUTPUT_VARIABLE status ERROR_QUIET RESULT_VARIABLE r2)
set(modified 0)
if(NOT r2 EQUAL 0 OR NOT status STREQUAL "")
  set(modified 1)
endif()
set(text "// generated by cmake/buildinfo.cmake\n#pragma once\n#define WKBAI_COMMIT \"${commit}\"\n#define WKBAI_MODIFIED ${modified}\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
